pipeline {
  agent any

  tools { jdk 'jdk17'; maven 'maven3' }

  options { timestamps(); skipDefaultCheckout(true) }

  stages {
    stage('Checkout') { steps { checkout scm } }

    stage('Build & Test') {
      steps {
        bat 'mvn -B -DskipTests=false clean package'
      }
      post {
        success {
          archiveArtifacts artifacts: 'target\\smart-study-app-*.jar', fingerprint: true
          junit allowEmptyResults: true, testResults: '**\\target\\surefire-reports\\*.xml'
        }
      }
    }

    stage('Deploy (Local Windows, background)') {
  environment { APP_DIR = 'C:\\smartstudy' }
  steps {
    withEnv([
      "GEMINI_API_KEY=${GEMINI_API_KEY}",
      "DB_USER=${DB_USER}",
      "DB_PASS=${DB_PASS}"
    ]) {
      bat '''
      echo Preparing deployment folders...
      if not exist "%APP_DIR%" mkdir "%APP_DIR%"
      if not exist "%APP_DIR%\\uploads" mkdir "%APP_DIR%\\uploads"
      if not exist "%APP_DIR%\\temp" mkdir "%APP_DIR%\\temp"
      if not exist "%APP_DIR%\\lucene-index" mkdir "%APP_DIR%\\lucene-index"

      echo Copying jar...
      copy /Y target\\smart-study-app-1.0.0.jar "%APP_DIR%\\app.jar"

      echo Stopping any existing SmartStudy process...
      for /f "tokens=2" %%a in ('netstat -ano ^| findstr :9090 ^| findstr LISTENING') do taskkill /F /PID %%a 2>nul
      ping 127.0.0.1 -n 3 > nul
      '''
      
      bat '''
      echo Creating startup script...
      echo @echo off > "%APP_DIR%\\start-app.bat"
      echo cd /d "%APP_DIR%" >> "%APP_DIR%\\start-app.bat"
      echo javaw -jar app.jar >> "%APP_DIR%\\start-app.bat"
      
      echo Creating scheduled task to start SmartStudy...
      schtasks /delete /tn "SmartStudyApp" /f 2>nul
      schtasks /create /tn "SmartStudyApp" /tr "%APP_DIR%\\start-app.bat" /sc once /st 00:00 /ru SYSTEM /f
      
      echo Starting SmartStudy via scheduled task...
      schtasks /run /tn "SmartStudyApp"
      
      echo Waiting 15 seconds for app startup...
      ping 127.0.0.1 -n 16 > nul
      
      echo Checking if app is running...
      netstat -ano | findstr :9090 | findstr LISTENING >nul && echo SUCCESS: App is listening on port 9090 || echo WARNING: App may not have started yet
      '''
    }
  }
}



    stage('Smoke Test') {
      steps {
        bat 'echo Deployment complete. App running at http://localhost:9090'
      }
    }
  }

  environment {
    GEMINI_API_KEY = credentials('gemini_api_key')
    DB_USER        = credentials('db_user')
    DB_PASS        = credentials('db_pass')
  }
}
