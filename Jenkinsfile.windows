pipeline {
  agent any

  tools { jdk 'jdk17'; maven 'maven3' }

  options { timestamps(); skipDefaultCheckout(true) }

  stages {
    stage('Checkout') { steps { checkout scm } }

    stage('Build & Test') {
      steps {
        bat 'mvn -B -DskipTests=false clean package'
      }
      post {
        success {
          archiveArtifacts artifacts: 'target\\smart-study-app-*.jar', fingerprint: true
          junit allowEmptyResults: true, testResults: '**\\target\\surefire-reports\\*.xml'
        }
      }
    }

    stage('SonarQube (optional)') {
      when { expression { return false } } // set to true when Sonar is configured
      environment { SCANNER_HOME = tool 'SonarScanner' }
      steps {
        withSonarQubeEnv('sonar') {
          bat '"%SCANNER_HOME%\\bin\\sonar-scanner.bat" -Dsonar.projectKey=smartstudy -Dsonar.sources=src/main/java -Dsonar.java.binaries=target/classes'
        }
      }
    }

    stage('Deploy (Local Windows, background)') {
      environment { APP_DIR = 'C:\\smartstudy' }
      steps {
        withEnv([
          "GEMINI_API_KEY=${GEMINI_API_KEY}",
          "DB_USER=${DB_USER}",
          "DB_PASS=${DB_PASS}"
        ]) {
          bat '''
          if not exist "%APP_DIR%" mkdir "%APP_DIR%"
          if not exist "%APP_DIR%\\uploads" mkdir "%APP_DIR%\\uploads"
          if not exist "%APP_DIR%\\temp" mkdir "%APP_DIR%\\temp"
          copy /Y target\\smart-study-app-1.0.0.jar "%APP_DIR%\\app.jar"

          rem Kill any previous java process
          for /f "tokens=2" %%a in ('netstat -ano ^| findstr :8081') do taskkill /F /PID %%a 2>nul
          ping 127.0.0.1 -n 3 > nul
          '''
          
          powershell '''
          $proc = Start-Process -FilePath "java" -ArgumentList @(
            "-jar", "C:\\smartstudy\\app.jar",
            "--server.port=8081",
            "--lucene.index.directory=C:\\smartstudy\\lucene-index",
            "--file.upload.directory=C:\\smartstudy\\uploads",
            "--file.temp.directory=C:\\smartstudy\\temp",
            "--spring.datasource.url=jdbc:mysql://localhost:3306/smartstudy?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true",
            "--spring.datasource.username=$env:DB_USER",
            "--spring.datasource.password=$env:DB_PASS",
            "--gemini.api.url=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent",
            "--gemini.api.key=$env:GEMINI_API_KEY"
          ) -PassThru -WindowStyle Hidden -RedirectStandardOutput "C:\\smartstudy\\smartstudy.out.log" -RedirectStandardError "C:\\smartstudy\\smartstudy.err.log"
          
          Write-Output "Started Java process with PID: $($proc.Id)"
          Start-Sleep -Seconds 10
          '''
        }
      }
    }

    stage('Smoke Test') {
      steps {
        bat 'echo Deployment complete. App running at http://localhost:8081'
      }
    }
  }

  environment {
    GEMINI_API_KEY = credentials('gemini_api_key')
    DB_USER        = credentials('db_user')
    DB_PASS        = credentials('db_pass')
  }
}
